# Production Environment Variables - copy to .env.production
# Loaded automatically by Next.js when NODE_ENV=production (pnpm build && pnpm start)
# NOTE: On Vercel, env vars are managed in the dashboard (vercel env add), NOT this file.

# Database - Production PostgreSQL (Neon)
DB_URL=postgresql://username:password@hostname:5432/database

# Application URLs - Production domain (MUST include scheme)
NEXT_PUBLIC_BASE_URL=https://yourdomain.com

# Session Secret - generate a UNIQUE prod secret: openssl rand -base64 32
SESSION_SECRET=your-production-super-secret-session-key-minimum-32-chars

# MercadoPago - Production access token (APP_USR- prefix, NOT PROD-)
MP_ACCESS_TOKEN=APP_USR-your-production-mercadopago-access-token

# Email - Production Resend API key
RESEND_API_KEY=re_your_production_resend_api_key

# Redis - Rate limiting (Upstash). Use a SEPARATE instance per environment
UPSTASH_REDIS_REST_URL=https://your-prod-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-prod-redis-token-here
