# Development Environment Variables - copy to .env.development
# Loaded automatically by Next.js when NODE_ENV=development (pnpm dev)

# Database - Development PostgreSQL (Neon)
DB_URL=postgresql://username:password@hostname:5432/database

# Application URLs - Local development server
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Session Secret - generate a UNIQUE dev secret: openssl rand -base64 32
SESSION_SECRET=dev-session-secret-change-me

# MercadoPago - Use TEST tokens for development (TEST- prefix)
MP_ACCESS_TOKEN=TEST-1234567890123456-123456-7890123456789012345678901234567890

# Email - Development Resend API key
RESEND_API_KEY=re_1234567890abcdef

# Redis - Rate limiting (Upstash). Use a SEPARATE instance per environment
UPSTASH_REDIS_REST_URL=https://your-dev-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-dev-redis-token-here
